const article = articles[slug] || articles['fix-buffering-streams'];
const title = article.title + ' | IPTV Ireland Blog';
const description = article.content[0].text;

const relatedPosts = [
  { slug: 'fix-buffering-streams', title: 'How to Fix Buffering on IPTV Streams', category: 'Troubleshooting' },
  { slug: 'install-lg-smart-tv', title: 'How to Install IPTV on Your LG Smart TV', category: 'Setup Guide' },
  { slug: 'firestick-optimization', title: 'Firestick Performance Tips for IPTV', category: 'Setup Guide' },
].filter(p => p.slug !== slug);
---

<Layout title={title} description={description} canonical={`/blog/${slug}/`}>
  <Header />
  <WhatsAppPopup />
  <WhatsPopup />

  <main class="relative min-h-screen pt-[80px] pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0E17] via-[#0D1321] to-[#0A0E17]" />
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(rgba(255,136,62,0.04) 1px, transparent 1px); background-size: 48px 48px;" />
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="px-3 py-1 rounded-lg bg-[#169B62]/10 text-[#169B62] text-[11px] font-semibold uppercase tracking-wider">{article.category}</span>
          <span class="text-[#5F6B80] text-sm">{article.date}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-8 font-['Space_Grotesk']">{article.title}</h1>
      </div>

      <article>
        {article.image && (
          <div class="w-full h-auto md:h-[400px] rounded-3xl overflow-hidden mb-12 border border-white/5 shadow-2xl relative">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E17] via-transparent to-transparent z-10"></div>
            <img src={article.image} alt={article.title} class="w-full h-full object-cover relative z-0" />
          </div>
        )}
        {article.content.map((block, i) => {
          if (block.type === 'h2') return <h2 class="text-2xl font-bold text-white mt-12 mb-4 font-['Space_Grotesk']">{block.text}</h2>;
          if (block.type === 'h3') return <h3 class="text-xl font-bold text-white mt-8 mb-3 font-['Space_Grotesk']">{block.text}</h3>;
          if (block.type === 'p') return <p class="text-[#8C96AA] leading-relaxed mb-6 text-lg">{block.text}</p>;
          if (block.type === 'img') return <div class="my-10"><img src={block.src} alt={block.alt || article.title} class="w-full h-auto rounded-2xl shadow-lg border border-white/5 object-cover" /></div>;
          return null;
        })}
      </article>

      <div class="mt-16">
        <div class="glass-card rounded-2xl p-8 text-center" style="background: linear-gradient(135deg, rgba(22,155,98,0.12), rgba(255,136,62,0.08)); border: 1px solid rgba(22,155,98,0.3);">
          <h3 class="text-xl font-bold text-white mb-2">Need Help With This?</h3>
          <p class="text-[#8C96AA] mb-6">IPTV Ireland offers 24/7 support via WhatsApp. Get expert help in minutes, not hours.</p>
          <a 
            href="https://wa.link/9ezhx6"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#169B62] to-[#0E6B42] text-white font-bold rounded-xl transition-all duration-300 hover:from-[#1BD97A] hover:to-[#169B62] shadow-lg"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Chat on WhatsApp
          </a>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <div class="mt-16">
          <h3 class="text-xl font-bold text-white mb-6">Related Articles</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {relatedPosts.map(post => (
              <a href={`/blog/${post.slug}/`} class="glass-card glass-card-hover rounded-2xl p-6 block group">
                <span class="px-2.5 py-1 rounded-lg bg-[#169B62]/10 text-[#169B62] text-[11px] font-semibold uppercase tracking-wider mb-2 inline-block">{post.category}</span>
                <h4 class="text-white font-bold group-hover:text-[#169B62] transition-colors">{post.title}</h4>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
