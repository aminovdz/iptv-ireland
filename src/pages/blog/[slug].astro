    'best-iptv-ireland-2026', 'watch-premier-league-iptv', 'is-iptv-legal-ireland', 'top-5-iptv-players-apple-tv', 'avoid-buffering-live-sports', 'iptv-vs-sky-ireland', 'tivimate-setup-guide', 'watch-uk-channels-ireland', 'best-broadband-iptv', 'iptv-smarters-pro-guide',
    'fix-buffering-streams',
    'install-lg-smart-tv',
    'firestick-optimization',
    'epg-guide-explained',
    'catchup-vs-vod',
    'internet-speed-requirements',
    'smart-tv-vs-firestick',
    'vpn-for-iptv',
    'recording-live-tv',
    'optimising-wifi-streaming',
    'parental-controls',
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

